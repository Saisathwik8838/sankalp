# 1. Port will be assigned automatically by your host (e.g. Render/Railway)
PORT=3001

# 2. CHANGE THIS: Generate a real 32+ character random secret string
JWT_SECRET=f9a8c7e6d5b4a3219087654321fedcba0987654321abcdef1234567890abcdef

# 3. CHANGE THIS: Set to your actual live Vercel domain (NO trailing slash)
CLIENT_ORIGIN=https://your-sankalp-app.vercel.app

# 4. Point to your persistent disk mount on the host
DATABASE_PATH=data/sankalp.db
